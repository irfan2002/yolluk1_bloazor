@page "/yolluk"
@inject HttpClient Http
@inject MudurlukToYollukService MudurlukService
@using Yolluk_frontend_blazor.Models.DTOs


<h3>Yolluk Sayfası</h3>

<input id="dilekceTarihi" type="date" class="form-control"
       @bind="DilekceTarihi" />

<p><strong>Seçilen Tarih:</strong> @DilekceTarihi.ToShortDateString()</p>

@if (uygunPersoneller == null)
{
    <p><em>Yükleniyor...</em></p>
}
else if (!uygunPersoneller.Any())
{
    <p><em>Uygun personel bulunamadı.</em></p>
}
else
{
    <h4>Uygun Personel Listesi</h4>
    <table class="table">
        <thead>
            <tr>
                <th>Sicil No</th>
                <th>Ad Soyad</th>
                <th>Müdürlük</th>
                <th>Toplam Tutar</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var personel in uygunPersoneller)
            {
                <tr>
                    <td>@personel.SicilNo</td>
                    <td>@personel.AdSoyad</td>
                    <td>@personel.MudurlukKodu</td>
                    <td>@personel.ToplamTutar.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<UygunPersonelDto> uygunPersoneller;
    private DateTime _dilekceTarihi = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        await GetUygunPersoneller();
    }

    private DateTime DilekceTarihi
    {
        get => _dilekceTarihi;
        set
        {
            if (_dilekceTarihi != value)
            {
                _dilekceTarihi = value;
                _ = GetUygunPersoneller(); // Tarih değiştiğinde veri güncellemesi yapılacak
            }
        }
    }

    private async Task GetUygunPersoneller()
    {
        var secilenKodlar = MudurlukService.SeciliMudurlukler;
        //secilenKodlar = await jsRuntime.InvokeAsync<List<string>>("getSelectedValues", "mudurlukSelect");

        if (DilekceTarihi == default || secilenKodlar == null || !secilenKodlar.Any())
            return;

        var kodlarParam = string.Join(",", secilenKodlar);
        var url = $"api/UygunPersonel/GetUygunPersoneller?mudurlukKodlari={kodlarParam}&dilekceTarihi={DilekceTarihi:yyyy-MM-dd}";

        Console.WriteLine($"Gelen Müdürlük Sayısı: {secilenKodlar?.Count ?? 0}");
        Console.WriteLine($"Gelen Dilekçe Tarihi: {DilekceTarihi}");

        try
        {
            uygunPersoneller = await Http.GetFromJsonAsync<List<UygunPersonelDto>>(url);
            StateHasChanged(); // UI'yi güncelle
        }
        catch (Exception ex)
        {
            Console.WriteLine("Hata: " + ex.Message);
            uygunPersoneller = new List<UygunPersonelDto>();
            StateHasChanged(); // UI'yi güncelle
        }
    }
}